<?xml version="1.0"?>
<SyntaxDefinition name="Enma" extensions=".enma" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Interpolation" foreground="#9CDCFE" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Keyword" foreground="#C586C0" />
  <Color name="Declaration" foreground="#E0457B" fontWeight="bold" />
  <Color name="Constant" foreground="#569CD6" />
  <Color name="Builtin" foreground="#DCDCAA" />
  <Color name="Api" foreground="#4EC9B0" />
  <Color name="Operator" foreground="#D7BA7D" />

  <RuleSet>
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="Comment" begin="//" />
    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
        <Span color="Interpolation" begin="\{" end="\}" />
      </RuleSet>
    </Span>
    <Span color="String">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>

    <Keywords color="Declaration">
      <Word>let</Word><Word>const</Word><Word>fn</Word><Word>class</Word>
    </Keywords>
    <Keywords color="Keyword">
      <Word>return</Word><Word>if</Word><Word>elif</Word><Word>else</Word><Word>while</Word><Word>for</Word>
      <Word>in</Word><Word>step</Word><Word>break</Word><Word>continue</Word><Word>and</Word><Word>or</Word>
      <Word>not</Word><Word>on</Word><Word>every</Word><Word>after</Word>
    </Keywords>
    <Keywords color="Constant">
      <Word>nil</Word><Word>true</Word><Word>false</Word><Word>self</Word>
    </Keywords>
    <Keywords color="Builtin">
      <Word>print</Word><Word>pairs</Word><Word>ipairs</Word><Word>next</Word><Word>type</Word><Word>tostring</Word>
      <Word>tonumber</Word><Word>select</Word><Word>error</Word><Word>assert</Word><Word>pcall</Word><Word>xpcall</Word>
      <Word>setmetatable</Word><Word>getmetatable</Word><Word>unpack</Word><Word>string</Word><Word>table</Word>
      <Word>math</Word><Word>os</Word><Word>coroutine</Word>
    </Keywords>
    <!-- Runtime API -->
    <Keywords color="Api">
      <Word>log</Word><Word>clock</Word><Word>on_tick</Word><Word>on_unload</Word><Word>timer</Word>
      <Word>time</Word><Word>json</Word><Word>script</Word>
    </Keywords>
    <Rule color="Operator">\|&gt;|\?\?|=&gt;|\.\.=?|\+\+</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b|\b\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?\b</Rule>
  </RuleSet>
</SyntaxDefinition>
