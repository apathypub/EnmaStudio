<Window x:Class="EnmaStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:ed="clr-namespace:EnmaStudio.Editor"
        xmlns:s="clr-namespace:EnmaStudio"
        xmlns:ag="clr-namespace:EnmaStudio.Agents"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Enma Studio"
        Width="1180" Height="740" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ui.Outline}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Ui.Font}"
        FontSize="{StaticResource Ui.FontSize}"
        Foreground="{StaticResource Ui.Text}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Custom title bar; keeps native resize, snap and maximize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Surfaces (darkest to lightest) -->
        <SolidColorBrush x:Key="Ed.Chrome" Color="#0C0C0C"/>
        <SolidColorBrush x:Key="Ed.Panel" Color="#101010"/>
        <SolidColorBrush x:Key="Ed.Code" Color="#131313"/>
        <SolidColorBrush x:Key="Ed.Hover" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="Ed.Selected" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Ed.Line" Color="#222222"/>
        <SolidColorBrush x:Key="Ed.Field" Color="#171717"/>
        <SolidColorBrush x:Key="Ed.Green" Color="#5BD65B"/>
        <SolidColorBrush x:Key="Ed.Red" Color="#E8404A"/>

        <!-- Thin scrollbars for the code view (both orientations). -->
        <ControlTemplate x:Key="VScroll" TargetType="ScrollBar">
            <Border Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource Ui.InvisibleRepeat}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource Ui.InvisibleRepeat}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource Ui.ScrollThumb}"/>
                    </Track.Thumb>
                </Track>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="HScroll" TargetType="ScrollBar">
            <Border Background="Transparent">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource Ui.InvisibleRepeat}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource Ui.InvisibleRepeat}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource Ui.ScrollThumb}"/>
                    </Track.Thumb>
                </Track>
            </Border>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template" Value="{StaticResource VScroll}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template" Value="{StaticResource HScroll}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flat buttons: toolbar (glyph + text), small icons, title bar. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Selected}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Ui.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Run: filled with the accent color. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#101010"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Ui.Accent}" Padding="{TemplateBinding Padding}"
                                CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Selected}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ui.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="{StaticResource Ui.IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui.IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Ed.Selected}"/>
                    <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Rounded chip (AI suggestions, "Opus 5" badge). -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
            <Setter Property="Background" Value="{StaticResource Ed.Field}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Ed.Line}"
                                BorderThickness="1" CornerRadius="12" Padding="11,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui.IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#101010"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="{DynamicResource Ui.Accent}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,1,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Ui.IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
        </Style>
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="8,9"/>
            <Setter Property="Background" Value="{StaticResource Ed.Line}"/>
        </Style>
        <!-- Language badge ("LUA", "FNL", ...) in the file's language color. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Borderless text box inside rounded fields; read-only copies show chat text. -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ui.Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Ui.Accent}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource Ed.Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ed.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Explorer rows: accent bar + lighter row when selected. -->
        <Style x:Key="FileRow" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Bd" Background="Transparent">
                            <Border x:Name="Bar" Width="2" HorizontalAlignment="Left"/>
                            <ContentPresenter Margin="12,6,10,6"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Selected}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Completion list rows (EnmaCompletion) -->
        <Style x:Key="CompletionRow" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Bd" Background="Transparent">
                            <Border x:Name="Bar" Width="2" HorizontalAlignment="Left"/>
                            <ContentPresenter Margin="8,3,8,3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Selected}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editor tabs -->
        <Style x:Key="EditorTab" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Height="34" Background="Transparent" Padding="12,0,6,0"
                                BorderBrush="{StaticResource Ed.Line}" BorderThickness="0,0,1,0">
                            <Grid>
                                <Border x:Name="Marker" Height="2" VerticalAlignment="Top" Margin="-12,0,-6,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Code}"/>
                                <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Find bar option toggles (Aa, whole word, regex) -->
        <Style x:Key="OptionToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Selected}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Welcome screen rows -->
        <Style x:Key="WelcomeButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Enma Studio: tab strip -->
        <Style x:Key="StudioTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="10,0" Height="30">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="Marker" Height="2" VerticalAlignment="Bottom" Margin="-10,0"
                                        Background="{DynamicResource Ui.Accent}" Visibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enma Studio: selectable chips (model, effort) -->
        <Style x:Key="ChoiceChip" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Padding="7,3" Margin="0,0,4,4" BorderThickness="1"
                                Background="{StaticResource Ed.Field}" BorderBrush="{StaticResource Ed.Line}">
                            <ContentPresenter TextElement.Foreground="{StaticResource Ui.Text}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ed.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceChip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ui.TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- Multi-line text field: bare TextBox inside the rounded field border -->
        <Style x:Key="AreaBox" TargetType="TextBox" BasedOn="{StaticResource BareTextBox}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{StaticResource Ui.Frame.Light}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Ui.Rainbow}"/>
            <Border Grid.Row="1" Background="{StaticResource Ui.Rainbow}" Opacity="0.5"/>

            <!-- Title bar: logo | open file | window buttons -->
            <Grid Grid.Row="2" Background="{StaticResource Ed.Chrome}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock FontWeight="Bold">
                        <Run Text="en"/><Run Text="ma" Foreground="{DynamicResource Ui.Accent}"/>
                    </TextBlock>
                    <TextBlock Text="studio" Margin="6,0,0,0" Foreground="{StaticResource Ui.TextMuted}"/>
                </StackPanel>
                <TextBlock x:Name="TitleFile" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Ui.TextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Height="34" Content="&#xE921;" ToolTip="Minimize"
                            Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Height="34" Content="&#xE922;"
                            ToolTip="Maximize" Click="Maximize_Click"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Height="34" Content="&#xE8BB;" ToolTip="Close"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="3" Background="{StaticResource Ed.Panel}" BorderBrush="{StaticResource Ed.Line}"
                    BorderThickness="0,1">
                <Grid Margin="8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FlatButton}" ToolTip="New file (Ctrl+N)" Click="New_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/>
                                <TextBlock Text="New" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveButton" Style="{StaticResource FlatButton}" ToolTip="Save (Ctrl+S)" Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;"/>
                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" ToolTip="Save all (Ctrl+Shift+S)" Click="SaveAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE78C;"/>
                                <TextBlock Text="Save all" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource Separator}"/>
                        <Button x:Name="RunButton" Style="{StaticResource AccentButton}" Click="Run_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="10"/>
                                <TextBlock Text="Run" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource FlatButton}" Margin="4,0,0,0" ToolTip="Stop (Shift+F5)"
                                Click="Stop_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;"/>
                                <TextBlock Text="Stop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource Separator}"/>
                        <Button Style="{StaticResource FlatButton}" ToolTip="Find (Ctrl+F) / replace (Ctrl+H)" Click="Find_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"/>
                                <TextBlock Text="Find" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource FlatButton}" ToolTip="Studio panel: agent team, training, evals, compiled Lua (Ctrl+E)"
                                Click="StudioToggle_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE902;" Foreground="#E0457B"/>
                                <TextBlock Text="Studio" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Explorer | editor + output | Studio -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" MinWidth="160"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition MinWidth="320"/>
                    <ColumnDefinition x:Name="AiSplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="AiColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Explorer -->
                <DockPanel Background="{StaticResource Ed.Panel}">
                    <Grid DockPanel.Dock="Top" Height="36" Margin="14,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="WorkspaceName" Style="{StaticResource SectionHeader}" Text="WORKSPACE"/>
                            <TextBlock x:Name="FileCount" Style="{StaticResource SectionHeader}" Margin="6,0,0,0"
                                       Foreground="{StaticResource Ui.TextDisabled}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="Refresh_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8DA;" ToolTip="Choose workspace folder"
                                    Click="ChooseFolder_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Show in Explorer"
                                    Click="OpenFolder_Click"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Margin="10,0,10,10">
                        <Border Style="{StaticResource FieldBorder}" Height="30">
                            <Grid Margin="10,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewName" Style="{StaticResource BareTextBox}" TextWrapping="NoWrap"
                                         VerticalAlignment="Center" KeyDown="NewName_KeyDown"/>
                                <TextBlock Text="new_script.enma" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Margin="2,0,0,0" Foreground="{StaticResource Ui.TextDisabled}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;"
                                        ToolTip="Create (Enter)" Click="New_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock Text=".enma  .lua" Margin="4,5,0,0" FontSize="10"
                                   Foreground="{StaticResource Ui.TextDisabled}"/>
                    </StackPanel>

                    <!-- Language badge, name, green dot while the script runs. -->
                    <ListBox x:Name="FileList" Margin="0" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource FileRow}"
                             MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Style="{StaticResource Ui.ScrollViewer}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="OpenSelected_Click"/>
                                <MenuItem Header="Delete" Click="Delete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ed:ScriptFile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Badge}" Background="{Binding Language.Color}" Opacity="0.9">
                                        <TextBlock Text="{Binding Language.Badge}" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="#101010" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="9,0,6,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Ellipse x:Name="Running" Grid.Column="2" Width="7" Height="7" Fill="{StaticResource Ed.Green}"
                                             Visibility="Collapsed" ToolTip="Running"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                        <Setter TargetName="Running" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Border Grid.Column="1" Background="{StaticResource Ed.Line}"/>
                <GridSplitter Grid.Column="1" Width="5" Margin="-2,0" HorizontalAlignment="Center" Background="Transparent"
                              Panel.ZIndex="1"/>

                <!-- Editor + output -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition MinHeight="80"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="170" MinHeight="60"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource Ed.Panel}" BorderBrush="{StaticResource Ed.Line}" BorderThickness="0,0,0,1"/>
                    <ListBox x:Name="TabList" Margin="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource EditorTab}" SelectionChanged="TabList_SelectionChanged">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter/>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ed:EditorDocument}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding Language.Color, FallbackValue=#777777}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Grid Width="20" Height="20" Margin="8,0,0,0">
                                        <Ellipse x:Name="Dirty" Width="7" Height="7" Fill="{StaticResource Ui.Text}"
                                                 Visibility="Collapsed"/>
                                        <Button x:Name="CloseTab" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                                FontSize="8" Width="20" Height="20" ToolTip="Close (Ctrl+W)" Click="CloseTab_Click"/>
                                    </Grid>
                                </StackPanel>
                                <!-- Unsaved: a dot instead of the close button, until hovered. -->
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDirty}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Dirty" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="CloseTab" Property="Visibility" Value="Hidden"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="1" Background="{StaticResource Ed.Code}">
                        <ae:TextEditor x:Name="Code" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="4,6,0,0"
                                       ShowLineNumbers="True" Background="{StaticResource Ed.Code}"
                                       Foreground="{StaticResource Ui.Text}" LineNumbersForeground="#3C3C3C"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

                        <!-- Welcome (no file open) -->
                        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="Bold">
                                <Run Text="en"/><Run Text="ma" Foreground="{DynamicResource Ui.Accent}"/>
                                <Run Text=" studio" FontWeight="Normal" Foreground="{StaticResource Ui.TextMuted}"/>
                            </TextBlock>
                            <TextBlock Text="A small language that compiles to Lua, with an editor and an agent team." HorizontalAlignment="Center"
                                       Margin="0,6,0,22" Foreground="{StaticResource Ui.TextMuted}"/>
                            <Button Style="{StaticResource WelcomeButton}" Click="NewEnma_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/>
                                        <TextBlock Text="New Enma script" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Ctrl+N" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource Ui.TextDisabled}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource WelcomeButton}" Click="TeamWelcome_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE716;" Foreground="#E0457B"/>
                                        <TextBlock Text="Let the agent team build one" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Ctrl+E" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource Ui.TextDisabled}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource WelcomeButton}" Click="TabDocs_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE82D;"/>
                                        <TextBlock Text="Language reference" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource WelcomeButton}" Click="ChooseFolder_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8DA;"/>
                                        <TextBlock Text="Choose workspace folder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <TextBlock Text="Double-click a file on the left to open it. F5 runs it."
                                       HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="{StaticResource Ui.TextDisabled}"/>
                        </StackPanel>

                        <!-- Find / replace (Ctrl+F, Ctrl+H) -->
                        <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,22,0" Width="420" Padding="6,6,6,6" CornerRadius="8" Background="#1A1A1A"
                                BorderBrush="{StaticResource Ed.Line}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.55"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="ReplaceToggle" Style="{StaticResource IconButton}" Width="20" Height="28"
                                        VerticalAlignment="Top" Content="&#xE76C;" ToolTip="Toggle replace (Ctrl+H)"
                                        Click="ReplaceToggle_Click"/>

                                <Border Grid.Column="1" Style="{StaticResource FieldBorder}" CornerRadius="5" Height="28"
                                        Margin="4,0,6,0">
                                    <Grid Margin="8,0,3,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FindBox" Style="{StaticResource BareTextBox}" TextWrapping="NoWrap"
                                                 VerticalAlignment="Center" TextChanged="FindBox_TextChanged"
                                                 PreviewKeyDown="FindBox_PreviewKeyDown"/>
                                        <TextBlock Text="Find" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"
                                                   Foreground="{StaticResource Ui.TextDisabled}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=FindBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ToggleButton x:Name="MatchCase" Style="{StaticResource OptionToggle}" Content="Aa"
                                                          ToolTip="Match case" Click="FindOption_Click"/>
                                            <ToggleButton x:Name="WholeWord" Style="{StaticResource OptionToggle}" Content="ab"
                                                          ToolTip="Whole word" Click="FindOption_Click"/>
                                            <ToggleButton x:Name="UseRegex" Style="{StaticResource OptionToggle}" Content=".*"
                                                          ToolTip="Regular expression" Click="FindOption_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="FindStatus" Width="62" VerticalAlignment="Center" TextAlignment="Center"
                                               FontSize="10.5" Foreground="{StaticResource Ui.TextMuted}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Previous (Shift+Enter, Shift+F3)"
                                            Click="FindPrevious_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Next (Enter, F3)"
                                            Click="FindNext_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="8" ToolTip="Close (Esc)"
                                            Click="FindClose_Click"/>
                                </StackPanel>

                                <Grid x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                                      Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource FieldBorder}" CornerRadius="5" Height="28" Margin="4,0,6,0">
                                        <Grid Margin="8,0,3,0">
                                            <TextBox x:Name="ReplaceBox" Style="{StaticResource BareTextBox}" TextWrapping="NoWrap"
                                                     VerticalAlignment="Center" PreviewKeyDown="ReplaceBox_PreviewKeyDown"/>
                                            <TextBlock Text="Replace" VerticalAlignment="Center" Margin="2,0,0,0"
                                                       IsHitTestVisible="False" Foreground="{StaticResource Ui.TextDisabled}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ReplaceBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FlatButton}" Height="24" Padding="8,0" Content="Replace"
                                                ToolTip="Replace this match (Enter)" Click="Replace_Click"/>
                                        <Button Style="{StaticResource FlatButton}" Height="24" Padding="8,0" Content="All"
                                                ToolTip="Replace all matches (Ctrl+Alt+Enter)" Click="ReplaceAll_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource Ed.Line}"/>
                    <GridSplitter Grid.Row="2" Height="5" Margin="0,-2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="Transparent" Panel.ZIndex="1"/>

                    <!-- Output (errors red, "loaded" green) -->
                    <DockPanel Grid.Row="3" Background="{StaticResource Ed.Panel}">
                        <Grid DockPanel.Dock="Top" Height="30" Margin="14,0,8,0">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="OUTPUT"/>
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Content="&#xE74D;"
                                    ToolTip="Clear" Click="ClearOutput_Click"/>
                        </Grid>
                        <ScrollViewer x:Name="OutputScroll" Style="{StaticResource Ui.ScrollViewer}">
                            <ItemsControl x:Name="OutputLines" Margin="14,0,10,8" SizeChanged="Output_SizeChanged"
                                          FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:LogLine}">
                                        <TextBlock x:Name="Line" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1"
                                                   Foreground="{StaticResource Ui.TextMuted}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Ed.Red}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Ed.Green}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- Right column: the Studio panel (hidden until toggled) -->
                <Border Grid.Column="3" Background="{StaticResource Ed.Line}"/>
                <GridSplitter x:Name="AiSplitter" Grid.Column="3" Width="5" Margin="-2,0" HorizontalAlignment="Center"
                              Background="Transparent" Visibility="Collapsed" Panel.ZIndex="1"/>
                <DockPanel x:Name="StudioPanel" Grid.Column="4" Background="{StaticResource Ed.Panel}" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Height="36" Margin="14,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE902;" Foreground="#E0457B"/>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="STUDIO"/>
                            <Border CornerRadius="3" Background="{StaticResource Ed.Selected}" Padding="5,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StudioVersionText" FontSize="9.5" Foreground="{StaticResource Ui.TextMuted}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE192;" ToolTip="Anthropic API key"
                                    Click="KeyToggle_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close (Ctrl+E)"
                                    Click="StudioToggle_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Ed.Line}" BorderThickness="0,0,0,1" Padding="6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabTeam" Style="{StaticResource StudioTab}" Content="Team" IsChecked="True"
                                         GroupName="Studio" Checked="StudioTab_Checked"/>
                            <RadioButton x:Name="TabTrain" Style="{StaticResource StudioTab}" Content="Train"
                                         GroupName="Studio" Checked="StudioTab_Checked"/>
                            <RadioButton x:Name="TabEvals" Style="{StaticResource StudioTab}" Content="Evals"
                                         GroupName="Studio" Checked="StudioTab_Checked"/>
                            <RadioButton x:Name="TabLua" Style="{StaticResource StudioTab}" Content="Lua"
                                         GroupName="Studio" Checked="StudioTab_Checked"/>
                            <RadioButton x:Name="TabDocs" Style="{StaticResource StudioTab}" Content="Docs"
                                         GroupName="Studio" Checked="StudioTab_Checked"/>
                        </StackPanel>
                    </Border>

                    <!-- API key (shown until a key is saved, or from the key icon) -->
                    <Border x:Name="KeyPanel" DockPanel.Dock="Top" Margin="12,10,12,2" Padding="12" CornerRadius="8"
                            Background="{StaticResource Ed.Field}" BorderBrush="{StaticResource Ed.Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Anthropic API key" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ui.TextMuted}" Margin="0,0,0,8"
                                       Text="The agents need a key from console.anthropic.com. It is stored encrypted for your Windows account in %APPDATA%\EnmaStudio; usage is billed to your Anthropic account. ANTHROPIC_API_KEY also works."/>
                            <PasswordBox x:Name="KeyBox" Margin="0,0,0,8" Height="24"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Save key" Click="SaveKey_Click"/>
                                <Button x:Name="RemoveKeyButton" Style="{StaticResource FlatButton}" Content="Remove key"
                                        Margin="6,0,0,0" Click="RemoveKey_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <!-- ============ Team: multi-agent harness ============ -->
                        <DockPanel x:Name="TeamView">
                            <StackPanel DockPanel.Dock="Top" Margin="14,10,12,4">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="PIPELINE"/>
                                <ItemsControl x:Name="PipelineList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Arrow}" Margin="2,0,6,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Ui.TextDisabled}"/>
                                                <Border CornerRadius="4" Padding="7,3" Background="{StaticResource Ed.Field}"
                                                        BorderBrush="{StaticResource Ed.Line}" BorderThickness="1"
                                                        ToolTip="{Binding Tip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding Color}" Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Review rounds" VerticalAlignment="Center" Margin="0,0,8,4"
                                               Foreground="{StaticResource Ui.TextMuted}"/>
                                    <ListBox x:Name="ReviewRoundsList" Style="{StaticResource ChipList}" SelectedIndex="2"
                                             SelectionChanged="ReviewRounds_SelectionChanged">
                                        <sys:String>0</sys:String>
                                        <sys:String>1</sys:String>
                                        <sys:String>2</sys:String>
                                        <sys:String>3</sys:String>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12">
                                <CheckBox x:Name="TeamIncludeFile" Content="Include the open file" IsChecked="True" Margin="2,0,0,8"/>
                                <Border Style="{StaticResource FieldBorder}" CornerRadius="10" MinHeight="44">
                                    <Grid Margin="12,0,7,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TeamInput" Style="{StaticResource BareTextBox}" AcceptsReturn="True"
                                                 MaxHeight="140" Padding="0,11" VerticalAlignment="Center"
                                                 PreviewKeyDown="TeamInput_PreviewKeyDown"/>
                                        <TextBlock Text="Give the team a task..." VerticalAlignment="Center" Margin="2,0,0,0"
                                                   IsHitTestVisible="False" Foreground="{StaticResource Ui.TextDisabled}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TeamInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button x:Name="TeamSendButton" Grid.Column="1" Style="{StaticResource SendButton}"
                                                Content="&#xE724;" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                                ToolTip="Run the team (Enter)" Click="TeamSend_Click"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TeamCostHint" Margin="4,5,0,0" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{StaticResource Ui.TextDisabled}"/>
                            </StackPanel>

                            <Grid>
                                <StackPanel Margin="14,8,10,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=TeamMessages}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="A team of agents builds it for you" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ui.TextMuted}" Margin="0,0,0,12"
                                               Text="The planner writes a plan, the coder writes the files and checks that they compile, the reviewer reads them and sends them back until it approves. Rate answers with thumbs up / down to train the agents."/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource ChipButton}" Content="Clock logger" Click="TeamSuggestion_Click"
                                                Tag="Create clock.enma that logs the current time (HH:mm:ss) every second for five seconds, then cancels its timer."/>
                                        <Button Style="{StaticResource ChipButton}" Content="Stopwatch class" Click="TeamSuggestion_Click"
                                                Tag="Create stopwatch.enma: a Stopwatch class with start(), stop(), lap() and elapsed() using time.ms(), and a demo that logs three laps one second apart."/>
                                        <Button Style="{StaticResource ChipButton}" Content="Port this script to Enma" Click="TeamSuggestion_Click"
                                                Tag="Port the open Lua script to an Enma script with the same name and behaviour (.enma extension)."/>
                                    </WrapPanel>
                                </StackPanel>

                                <ScrollViewer x:Name="TeamScroll" Style="{StaticResource Ui.ScrollViewer}">
                                    <ItemsControl x:Name="TeamMessages" Margin="12,0,8,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ag:TeamEntry}">
                                                <Grid SizeChanged="TeamMessage_SizeChanged">
                                                    <!-- You -->
                                                    <Border x:Name="UserView" Visibility="Collapsed" Margin="24,12,0,2" Padding="10,7"
                                                            CornerRadius="8" Background="{StaticResource Ed.Selected}">
                                                        <TextBox Style="{StaticResource BareTextBox}" IsReadOnly="True"
                                                                 Text="{Binding Text, Mode=OneWay}"/>
                                                    </Border>
                                                    <!-- Stage: "Coder is writing code..." -->
                                                    <StackPanel x:Name="StageView" Visibility="Collapsed" Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding AgentColor}" Margin="0,0,7,0"
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Text}" FontStyle="Italic"
                                                                   Foreground="{StaticResource Ui.TextMuted}"/>
                                                    </StackPanel>
                                                    <!-- Agent text with training feedback -->
                                                    <Border x:Name="TextView" Visibility="Collapsed" Margin="0,6,0,2" Padding="10,7,8,6"
                                                            CornerRadius="6" BorderThickness="2,0,0,0" BorderBrush="{Binding AgentColor}"
                                                            Background="#141414">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding AgentName}" FontWeight="Bold" FontSize="10"
                                                                       Foreground="{Binding AgentColor}" Margin="0,0,0,3"/>
                                                            <TextBox Style="{StaticResource BareTextBox}" IsReadOnly="True"
                                                                     Text="{Binding Text, Mode=OneWay}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Button Style="{StaticResource IconButton}" Content="&#xE8E1;" Width="22" Height="22"
                                                                        FontSize="11" ToolTip="Good answer: save as a training example"
                                                                        Click="TeamRateUp_Click"
                                                                        IsEnabled="{Binding IsRated, Converter={StaticResource Ui.InverseBool}}"/>
                                                                <Button Style="{StaticResource IconButton}" Content="&#xE8E0;" Width="22" Height="22"
                                                                        FontSize="11" ToolTip="Needs work: write a lesson for this agent"
                                                                        Click="TeamRateDown_Click"
                                                                        IsEnabled="{Binding IsRated, Converter={StaticResource Ui.InverseBool}}"/>
                                                                <TextBlock Text="{Binding RatingText}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                           FontSize="10" Foreground="{StaticResource Ui.TextMuted}"/>
                                                            </StackPanel>
                                                            <StackPanel Visibility="{Binding IsCritiquing, Converter={StaticResource Ui.BoolToVis}}"
                                                                        Margin="0,4,0,0">
                                                                <Border Style="{StaticResource FieldBorder}" CornerRadius="5">
                                                                    <TextBox Style="{StaticResource AreaBox}" MinHeight="44"
                                                                             Text="{Binding Critique, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </Border>
                                                                <TextBlock Text="What should this agent do differently next time?" FontSize="10"
                                                                           Foreground="{StaticResource Ui.TextDisabled}" Margin="2,3,0,4"/>
                                                                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                                                        Content="Save lesson" Click="TeamSaveLesson_Click"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- File action -->
                                                    <Button x:Name="ActionView" Visibility="Collapsed" Margin="10,4,0,0"
                                                            HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Height="24"
                                                            Padding="8,0" Click="TeamAction_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Foreground="{Binding AgentColor}"/>
                                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Reviewer verdict -->
                                                    <Border x:Name="VerdictView" Visibility="Collapsed" Margin="10,8,0,0" Padding="8,3"
                                                            CornerRadius="4" HorizontalAlignment="Left" Background="{StaticResource Ed.Selected}">
                                                        <TextBlock x:Name="VerdictText" Text="{Binding Text}" FontWeight="Bold"/>
                                                    </Border>
                                                    <!-- Error / done -->
                                                    <TextBlock x:Name="ErrorView" Visibility="Collapsed" Margin="0,8,0,2" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Ed.Red}" Text="{Binding Text}"/>
                                                    <TextBlock x:Name="DoneView" Visibility="Collapsed" Margin="0,12,0,4" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Ed.Green}" Text="{Binding Text}"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter TargetName="UserView" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Stage">
                                                        <Setter TargetName="StageView" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Kind}" Value="Text"/>
                                                            <Condition Binding="{Binding IsUser}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="TextView" Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Action">
                                                        <Setter TargetName="ActionView" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Verdict">
                                                        <Setter TargetName="VerdictView" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text}" Value="Approved">
                                                        <Setter TargetName="VerdictText" Property="Foreground" Value="{StaticResource Ed.Green}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                        <Setter TargetName="ErrorView" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Done">
                                                        <Setter TargetName="DoneView" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>

                        <!-- ============ Train: agent profiles, lessons, examples ============ -->
                        <DockPanel x:Name="TrainView" Visibility="Collapsed">
                            <ListBox x:Name="TrainAgents" DockPanel.Dock="Top" Margin="0,8,0,4" Background="Transparent"
                                     BorderThickness="0" ItemContainerStyle="{StaticResource FileRow}"
                                     SelectionChanged="TrainAgents_SelectionChanged">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ag:AgentProfile}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource Ui.TextDisabled}"/>
                                            </TextBlock>
                                            <TextBlock x:Name="Ver" Grid.Column="2" VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{StaticResource Ui.TextMuted}">
                                                <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12">
                                <WrapPanel>
                                    <Button Style="{StaticResource AccentButton}" Content="Save" Margin="0,0,6,6" Click="TrainSave_Click"
                                            ToolTip="Save all agents; a changed agent gets a new version"/>
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Click="TrainDistill_Click"
                                            ToolTip="Ask the model to fold the lessons into better role instructions">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" Foreground="{DynamicResource Ui.Accent}"/>
                                            <TextBlock Text="Distill lessons" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" Content="Export dataset" Margin="0,0,6,6"
                                            Click="TrainExport_Click" ToolTip="Write the examples as a JSONL chat dataset"/>
                                    <Button Style="{StaticResource FlatButton}" Content="Reset agent" Margin="0,0,6,6"
                                            Click="TrainReset_Click" ToolTip="Restore this agent's default instructions (keeps lessons and examples)"/>
                                </WrapPanel>
                                <TextBlock x:Name="TrainStatus" TextWrapping="Wrap" FontSize="10.5"
                                           Foreground="{StaticResource Ui.TextMuted}"/>
                            </StackPanel>

                            <ScrollViewer Style="{StaticResource Ui.ScrollViewer}">
                                <StackPanel x:Name="TrainEditor" Margin="14,0,12,8"
                                            DataContext="{Binding SelectedItem, ElementName=TrainAgents}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="NAME"/>
                                    <Border Style="{StaticResource FieldBorder}" Height="28">
                                        <TextBox Style="{StaticResource BareTextBox}" Margin="8,0" VerticalAlignment="Center"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>
                                    <CheckBox Content="Takes part in team runs" Margin="2,8,0,0" IsChecked="{Binding Enabled}"
                                              Click="TrainEnabled_Click"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MODEL"/>
                                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{x:Static ag:AgentModels.All}"
                                             SelectedItem="{Binding Model}"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="EFFORT"/>
                                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{x:Static ag:AgentModels.Efforts}"
                                             SelectedItem="{Binding Effort}"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="ROLE INSTRUCTIONS"/>
                                    <Border Style="{StaticResource FieldBorder}" CornerRadius="6">
                                        <TextBox x:Name="TrainInstructions" Style="{StaticResource AreaBox}" Height="150"
                                                 Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>

                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="LESSONS ("/><Run Text="{Binding Lessons.Count, Mode=OneWay}"/><Run Text=") — added to the prompt"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Lessons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,6,0"/>
                                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                                            FontSize="8" Width="20" Height="20" VerticalAlignment="Top"
                                                            ToolTip="Remove" Click="TrainRemoveLesson_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource FieldBorder}" Height="28" Margin="0,2,0,0">
                                        <Grid Margin="8,0,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewLessonBox" Style="{StaticResource BareTextBox}" VerticalAlignment="Center"
                                                     KeyDown="NewLesson_KeyDown"/>
                                            <TextBlock Text="Add a lesson..." VerticalAlignment="Center" Margin="2,0,0,0"
                                                       IsHitTestVisible="False" Foreground="{StaticResource Ui.TextDisabled}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=NewLessonBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;"
                                                    ToolTip="Add (Enter)" Click="TrainAddLesson_Click"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="EXAMPLES ("/><Run Text="{Binding Examples.Count, Mode=OneWay}"/><Run Text=") — the newest 4 are shown to the agent"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Examples}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ag:AgentExample}">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Output}" TextTrimming="CharacterEllipsis" MaxHeight="32"
                                                               TextWrapping="Wrap" Margin="0,2,6,0" Foreground="{StaticResource Ui.TextMuted}"
                                                               ToolTip="{Binding Output}"/>
                                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                                            FontSize="8" Width="20" Height="20" VerticalAlignment="Top"
                                                            ToolTip="Remove" Click="TrainRemoveExample_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Ui.TextDisabled}" Margin="0,4,0,0"
                                               Text="Training is prompt-level: lessons and examples become part of the agent's system prompt. Use the Evals tab to check that a new version actually scores better."/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- ============ Evals: test cases for the team ============ -->
                        <DockPanel x:Name="EvalsView" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Height="32" Margin="14,6,8,0">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="TEST CASES" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New case" Click="EvalAdd_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete case" Click="EvalDelete_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Save cases" Click="EvalSave_Click"/>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="EvalList" DockPanel.Dock="Top" MaxHeight="120" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource FileRow}" DisplayMemberPath="Name">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ScrollViewer Style="{StaticResource Ui.ScrollViewer}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>

                            <StackPanel DockPanel.Dock="Top" Margin="14,0,12,0" DataContext="{Binding SelectedItem, ElementName=EvalList}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=EvalList}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="NAME"/>
                                <Border Style="{StaticResource FieldBorder}" Height="28">
                                    <TextBox Style="{StaticResource BareTextBox}" Margin="8,0" VerticalAlignment="Center"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TASK FOR THE TEAM"/>
                                <Border Style="{StaticResource FieldBorder}" CornerRadius="6">
                                    <TextBox Style="{StaticResource AreaBox}" Height="60"
                                             Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CHECKS — exists / compiles / contains / not_contains FILE [TEXT], approved"/>
                                <Border Style="{StaticResource FieldBorder}" CornerRadius="6">
                                    <TextBox Style="{StaticResource AreaBox}" Height="90" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                             Text="{Binding Checks, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,10,12,4">
                                <Button x:Name="EvalRunButton" Style="{StaticResource AccentButton}" Click="EvalRun_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="EvalRunGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="10"/>
                                        <TextBlock x:Name="EvalRunText" Text="Run all cases" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="EvalProgress" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Ui.TextMuted}" MaxWidth="240"/>
                            </StackPanel>

                            <ScrollViewer Style="{StaticResource Ui.ScrollViewer}">
                                <StackPanel Margin="14,4,12,10">
                                    <ItemsControl x:Name="EvalResults">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ag:EvalResult}">
                                                <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6" Background="#141414"
                                                        BorderThickness="2,0,0,0" x:Name="Card" BorderBrush="{StaticResource Ed.Red}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock FontWeight="Bold">
                                                                <Run Text="{Binding Case, Mode=OneWay}"/>
                                                                <Run Text="{Binding Summary, Mode=OneWay}" FontWeight="Normal"
                                                                     Foreground="{StaticResource Ui.TextMuted}"/>
                                                            </TextBlock>
                                                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                                                    Content="&#xE838;" Width="20" Height="20" FontSize="10"
                                                                    ToolTip="Open the files the agents wrote" Click="EvalOpenFolder_Click"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="10.5" Margin="0,4,0,0"
                                                                   FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Ui.TextMuted}"/>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Ed.Green}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="HISTORY (newest first)"/>
                                    <ItemsControl x:Name="EvalHistory">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ag:EvalRunSummary}">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="10.5" Margin="0,0,0,3"
                                                           Foreground="{StaticResource Ui.TextMuted}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- ============ Lua: live compiled output of the open .enma file ============ -->
                        <DockPanel x:Name="LuaView" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Height="34" Margin="14,4,8,0">
                                <TextBlock x:Name="LuaViewTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,150,0" Foreground="{StaticResource Ui.TextMuted}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource FlatButton}" Height="24" Padding="8,0" Content="Copy"
                                            Click="LuaCopy_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Height="24" Padding="8,0" Content="Export .lua"
                                            Margin="4,0,0,0" Click="LuaExport_Click"
                                            ToolTip="Save the compiled Lua next to the script, for people without Enma"/>
                                </StackPanel>
                            </Grid>
                            <ae:TextEditor x:Name="LuaPreview" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="4,6,0,0"
                                           ShowLineNumbers="True" IsReadOnly="True" WordWrap="True"
                                           Background="{StaticResource Ed.Code}" Foreground="{StaticResource Ui.Text}"
                                           LineNumbersForeground="#3C3C3C"/>
                        </DockPanel>

                        <!-- ============ Docs ============ -->
                        <DockPanel x:Name="DocsView" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,10,12,6">
                                <Button Style="{StaticResource AccentButton}" Content="New Enma script" Click="NewEnma_Click"/>
                            </StackPanel>
                            <ScrollViewer Style="{StaticResource Ui.ScrollViewer}" HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="DocsText" Style="{StaticResource BareTextBox}" IsReadOnly="True" Margin="14,4,12,12"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="5" Background="{StaticResource Ed.Chrome}" BorderBrush="{StaticResource Ed.Line}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Ui.TextMuted}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,380,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel x:Name="RunningText" Orientation="Horizontal" Margin="0,0,18,0" Visibility="Collapsed">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Ed.Green}" Margin="0,0,6,0"/>
                            <TextBlock Text="running" Foreground="{StaticResource Ed.Green}"/>
                        </StackPanel>
                        <Button x:Name="ProblemsButton" Style="{StaticResource FlatButton}" Height="20" Padding="6,0"
                                Margin="0,0,12,0" Visibility="Collapsed" Click="Problems_Click"
                                ToolTip="Enma problems: click to jump to the next one (F8)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEA39;" Foreground="{StaticResource Ed.Red}" Margin="0,0,4,0"/>
                                <TextBlock x:Name="ErrorCountText" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="#D7BA3D" Margin="0,0,4,0"/>
                                <TextBlock x:Name="WarningCountText" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="CaretText" Margin="0,0,18,0" Foreground="{StaticResource Ui.TextMuted}"/>
                        <TextBlock x:Name="LanguageText" Margin="0,0,18,0" Foreground="{StaticResource Ui.TextMuted}"/>
                        <TextBlock Text="UTF-8" Foreground="{StaticResource Ui.TextMuted}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
